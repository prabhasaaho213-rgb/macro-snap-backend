GEMINI_KEY=your_gemini_api_key_here
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Firebase Admin (Firestore dual-write - Phase 1 of the Firestore migration)
# Service-account JSON for the same Firebase project as the app
# (macrosnap-cfde3). Get it from Firebase Console > Project settings >
# Service accounts > Generate new private key, then paste the ENTIRE JSON as
# a single-line value. Without it, dual-write stays disabled and the server
# behaves exactly as before (Postgres only).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Deletion-tombstone fingerprint key — REQUIRED in production (the server
# refuses to boot without it when VERCEL_ENV/NODE_ENV is production).
# Generate with: openssl rand -hex 32
#
# This key turns the identifier of a deleted account into an opaque HMAC in
# `deletedAccounts`, which is what stops the ₹1 first month being claimed twice.
# It must be DEDICATED (never reuse RAZORPAY_KEY_SECRET: rotating the payment
# keys would re-key every fingerprint and re-open the offer to every deleted
# account) and it must stay stable.
#
# There is no way to re-key fingerprints that already exist (HMAC is one-way),
# so changing this value means every account that deleted BEFORE the change can
# claim the 1-rupee month again. Treat it as permanent.
#
# Leaving it empty uses a fixed development key: fingerprints made with it
# enforce nothing, so the server then writes NO tombstones and publishes NO
# key canary. That is what keeps a preview deployment or a laptop that shares
# production credentials from putting a dev-key canary there first.
TOMBSTONE_SECRET=
