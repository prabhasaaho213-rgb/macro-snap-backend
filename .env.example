GEMINI_KEY=your_gemini_api_key_here
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Firebase Admin (Firestore dual-write - Phase 1 of the Firestore migration)
# Service-account JSON for the same Firebase project as the app
# (macrosnap-cfde3). Get it from Firebase Console > Project settings >
# Service accounts > Generate new private key, then paste the ENTIRE JSON as
# a single-line value. Without it, dual-write stays disabled and the server
# behaves exactly as before (Postgres only).
FIREBASE_SERVICE_ACCOUNT_JSON=
